{
  "name": {
    "en": "Balboa BWA Local",
    "nl": "Balboa BWA Lokaal"
  },
  "capabilities": [
    "alarm_connectivity",
    "target_temperature",
    "measure_temperature",
    "measure_heater",
    "measure_heater_mode",
    "action_light_state",
    "action_heater_mode",
    "action_temp_range",
    "action_update_data"
  ],
  "capabilitiesOptions": {
    "action_pump_state.1": {
      "title": {
        "en": "Pump State 2",
        "nl": "Pomp Status 2"
      }
    },
    "action_pump_state.2": {
      "title": {
        "en": "Pump State 3",
        "nl": "Pomp Status 3"
      }
    },
    "action_pump_state.3": {
      "title": {
        "en": "Pump State 4",
        "nl": "Pomp Status 4"
      }
    },
    "action_pump_state.4": {
      "title": {
        "en": "Pump State 5",
        "nl": "Pomp Status 5"
      }
    },
    "action_pump_state.5": {
      "title": {
        "en": "Pump State 6",
        "nl": "Pomp Status 6"
      }
    },
    "action_blower_state.1": {
      "title": {
        "en": "Blower State 2",
        "nl": "Blazer Status 2"
      }
    },
    "action_blower_state.2": {
      "title": {
        "en": "Blower State 3",
        "nl": "Blazer Status 3"
      }
    },
    "target_temperature": {
      "min": 10,
      "max": 40,
      "step": 0.5
    }
  },
  "pair": [
    {
      "id": "select_mode"
    },
    {
      "id": "manual_ip"
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "prev": "select_mode",
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "General settings",
        "nl": "Algemene instellingen"
      },
      "children": [
        {
          "id": "update_interval",
          "type": "number",
          "label": {
            "en": "Update interval",
            "nl": "Update interval"
          },
          "min": 10,
          "max": 3600,
          "units": {
            "en": "seconds",
            "nl": "seconden"
          },
          "value": 600
        },
        {
          "id": "round_temp",
          "type": "checkbox",
          "label": {
            "en": "Round temperature",
            "nl": "Temperatuur afronden"
          },
          "value": false
        }
      ]
    }
  ],
  "$extends": ["device"]
}
